# Brújula Backend — Environment Variables Example
# Copy this file to .env and fill in real values for local development.
# NEVER commit a .env file with real secrets.

# =============================================================================
# Slice 1 — OIDC backend client secret (brujula-backend confidential client)
# =============================================================================
# Override the placeholder in application-local.yaml
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# =============================================================================
# Slice 2 — Keycloak Admin API service-account client (S2-A addition)
# brujula-registration-svc: confidential client with manage-users role on realm-management.
# See ops/local/keycloak/realm-export.json for the client configuration.
# =============================================================================
BRUJULA_KEYCLOAK_REGISTRATION_SVC_CLIENT_SECRET=CHANGE_ME_REGISTRATION_SVC

# =============================================================================
# Slice 3 — Local-first DB backup / restore (RF-03, RF-05, RF-06)
# These vars are read ONLY by scripts/db/backup.sh and scripts/db/restore.sh.
# They are NOT loaded by Spring Boot — Spring reads application*.yaml exclusively.
# =============================================================================

# PostgreSQL connection used by pg_dump / psql scripts
DB_HOST=localhost
DB_PORT=5432
DB_NAME=planner_db
DB_USER=brujula
DB_PASSWORD=change_me

# age encryption key for DB backups
# Generate a keypair with:
#   age-keygen -o ~/Desktop/brujula-key.txt           # Linux / macOS
#   age-keygen -o C:\Users\<user>\Desktop\brujula-key.txt  # Windows
# Then paste the "# public key: age1..." line value below.
# IMPORTANT: the private key file MUST be kept OUTSIDE the repository directory.
AGE_PUBLIC_KEY=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Full path to the age private key file — MUST be OUTSIDE the repository directory.
# Linux / macOS example:
#   AGE_PRIVATE_KEY_PATH=~/Desktop/brujula-key.txt
# Windows example (use forward slashes or raw backslashes):
#   AGE_PRIVATE_KEY_PATH=C:\Users\<user>\Desktop\brujula-key.txt
AGE_PRIVATE_KEY_PATH=~/Desktop/brujula-key.txt
