{
  "realm": "brujula-dev",
  "displayName": "Brújula Dev Realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@brujula.local",
    "fromDisplayName": "Brújula Dev",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },

  "roles": {
    "realm": [
      {
        "name": "STUDENT",
        "description": "Estudiante — acceso a planeación curricular personal"
      },
      {
        "name": "STAFF",
        "description": "Personal administrativo — acceso a datos de programas asignados"
      },
      {
        "name": "ADMIN",
        "description": "Administrador de la plataforma — acceso total a /admin/**"
      }
    ]
  },

  "users": [
    {
      "username": "admin-brujula",
      "email": "admin@uniquindio.edu.co",
      "firstName": "Admin",
      "lastName": "Brújula",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin_Dev_2024!",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "student-brujula",
      "email": "student@uniquindio.edu.co",
      "firstName": "Student",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Student_Dev_2024!",
          "temporary": false
        }
      ],
      "realmRoles": ["STUDENT"]
    },
    {
      "username": "staff-brujula",
      "email": "staff@uniquindio.edu.co",
      "firstName": "Staff",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Staff_Dev_2024!",
          "temporary": false
        }
      ],
      "realmRoles": ["STAFF"]
    }
  ],

  "clients": [
    {
      "clientId": "brujula-backend",
      "name": "Brújula Backend (confidential OIDC)",
      "description": "Confidential backend client for server-side OIDC login flow (authorization_code).",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "brujula-frontend",
      "name": "Brújula Frontend (SPA — public client)",
      "description": "Public OIDC client for the Brújula SPA. directAccessGrantsEnabled:true for ROPC token minting in k6 load tests.",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174"
      ],
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "brujula-registration-svc",
      "name": "Brújula Registration Service Account",
      "description": "Confidential service-account client for backend-driven user provisioning via Keycloak Admin API.",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_REGISTRATION_SVC",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": false
    }
  ],

  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "brujula-registration-svc",
        "roles": ["manage-users", "view-users"]
      }
    ]
  }
}
