# ============================================================
# Local development environment variables (AGENTS §3.1 / TRD §16)
# Copy to .env and fill in real values. NEVER commit .env.
# All values here are PLACEHOLDERS — no real secrets.
# ============================================================

# ----------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------
POSTGRES_USER=brujula
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=planner_db

# ----------------------------------------------------------------
# Keycloak admin credentials
# ----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Keycloak database (shares the postgres service via a second database)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_DB_USERNAME=brujula
KC_DB_PASSWORD=CHANGE_ME

# ----------------------------------------------------------------
# Backend datasource (used when running compose.full.yaml)
# ----------------------------------------------------------------
BRUJULA_DB_URL=jdbc:postgresql://postgres:5432/planner_db
BRUJULA_DB_USERNAME=brujula
BRUJULA_DB_PASSWORD=CHANGE_ME

# ----------------------------------------------------------------
# Spring profiles / ports
# ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ----------------------------------------------------------------
# Frontend (used when running compose.full.yaml)
# ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
